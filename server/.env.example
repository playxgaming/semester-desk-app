GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Thinking tokens for 2.5 Flash models (0 = off, fastest; -1 = dynamic).
GEMINI_THINKING_BUDGET=0
PORT=3001
# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Set to 1 behind Render's reverse proxy; keep 0 for direct local serving.
TRUST_PROXY_HOPS=0
