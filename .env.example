# Sync is optional. Leave this file untouched (or delete it) and the app runs
# entirely on your device — IndexedDB only, no account, nothing leaves the
# browser. Fill these in and the same build syncs across phone and laptop.
#
#   1. create a free project at supabase.com
#   2. run supabase/migrations/0001_init.sql in its SQL editor
#   3. copy this file to .env and paste the two values below
#   4. restart `npm run dev`
#
# The anon key is safe in the browser — row-level security is what protects
# your rows. The Anthropic key is NOT: it lives only in Supabase secrets, and
# is used by supabase/functions/ai. Never put it in this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional AI server URL, e.g. https://your-api.onrender.com (no trailing /api).
# Leave blank locally: Vite proxies /api to localhost:3001.
# Never put GEMINI_API_KEY in a VITE_ variable.
VITE_AI_API_URL=
